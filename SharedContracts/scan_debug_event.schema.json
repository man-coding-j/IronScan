{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironscan.local/schemas/scan_debug_event.schema.json",
  "title": "IronScan anonymous scan debug event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testRunId",
    "capturedAt",
    "anonymousFixtureId",
    "calibrationMode",
    "qualityScore",
    "rejectionReasons",
    "segmentationConfidence",
    "calibrationResidual",
    "conditionNumber",
    "specularFraction",
    "decision",
    "segmentationLatencyMs",
    "calibrationLatencyMs",
    "riskLatencyMs",
    "totalLatencyMs"
  ],
  "properties": {
    "testRunId": { "type": "integer", "minimum": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "anonymousFixtureId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "calibrationMode": { "enum": ["multiPatchReference", "neutralPatchReference", "teethPseudoReference", "uncalibratedRejected"] },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "rejectionReasons": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxItems": 32 },
    "segmentationConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "calibrationResidual": { "type": ["number", "null"], "minimum": 0 },
    "conditionNumber": { "type": ["number", "null"], "minimum": 0 },
    "specularFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "decision": { "enum": ["lowerObservedRisk", "possibleRisk", "unableToAssess"] },
    "segmentationLatencyMs": { "type": "number", "minimum": 0 },
    "calibrationLatencyMs": { "type": "number", "minimum": 0 },
    "riskLatencyMs": { "type": "number", "minimum": 0 },
    "totalLatencyMs": { "type": "number", "minimum": 0 },
    "expectedLabel": { "type": ["string", "null"], "enum": ["lowerObservedRisk", "possibleRisk", "unableToAssess", null] },
    "expectedHemoglobin": { "type": ["number", "null"], "minimum": 0, "maximum": 30 }
  }
}
